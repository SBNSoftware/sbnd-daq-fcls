#include "NevisTPC2StreamEXT_driver_default.fcl"
#======Place override parameters below=========
daq.fragment_receiver.DumpBinary: true # Write binary file for SN continuous readout
daq.fragment_receiver.DumpSNBinary: false # Write binary file for SN continuous readout
daq.fragment_receiver.DoSNReadout: false # Do continuous readout
daq.fragment_receiver.nevis_crate.fem_fake_data: true # Run fake data mode
daq.fragment_receiver.nevis_crate.fem_fake_data_pattern: "channel"
