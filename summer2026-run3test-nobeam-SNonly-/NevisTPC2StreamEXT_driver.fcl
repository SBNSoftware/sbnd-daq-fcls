#include "NevisTPC2StreamEXT_driver_default.fcl"
#======Place override parameters below=========
daq.fragment_receiver.DumpSNBinary: true # Write binary file for SN continuous readout
daq.fragment_receiver.DoSNReadout: true # Do continuous readout
daq.fragment_receiver.EnableSNFailover: false # Turn off SN failover for SN-only config
daq.fragment_receiver.DisableNUStream: true # Disable NU stream 
daq.fragment_receiver.DumpBinary: false # Write binary file for NU readout

